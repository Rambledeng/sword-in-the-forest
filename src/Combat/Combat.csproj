<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure combat rules shared by the game and the tests. No Godot types. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SwordInTheForest.Combat</RootNamespace>
    <AssemblyName>SwordInTheForest.Combat</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Director\Director.csproj" />
  </ItemGroup>

</Project>
